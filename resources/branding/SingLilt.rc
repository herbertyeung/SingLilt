#include <windows.h>
#include "Version.h"

IDI_SINGLILT ICON "singlilt.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SINGLILT_FILE_VERSION
 PRODUCTVERSION SINGLILT_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Herbert Yeung\0"
            VALUE "FileDescription", "SingLilt - Numbered-notation singing practice\0"
            VALUE "FileVersion", SINGLILT_VERSION_TEXT
            VALUE "InternalName", "SingLilt\0"
            VALUE "OriginalFilename", "SingLilt.exe\0"
            VALUE "ProductName", "SingLilt\0"
            VALUE "ProductVersion", SINGLILT_VERSION_TEXT
            VALUE "LegalCopyright", "Copyright (c) 2026 Herbert Yeung\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
