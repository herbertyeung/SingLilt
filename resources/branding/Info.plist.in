<key>CFBundleDocumentTypes</key><array><dict><key>CFBundleTypeName</key><string>SingLilt Project</string><key>CFBundleTypeRole</key><string>Editor</string><key>CFBundleTypeExtensions</key><array><string>jpp</string></array></dict></array>
