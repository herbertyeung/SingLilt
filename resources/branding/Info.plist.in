<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>SingLilt</string>
<key>CFBundleIdentifier</key><string>com.herbertyeung.SingLilt</string>
