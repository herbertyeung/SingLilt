{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "SINGLILT_BUILD_APP": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core tests without application dependencies",
      "inherits": "vs2026",
      "cacheVariables": {
        "SINGLILT_BUILD_APP": "OFF"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux desktop (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SINGLILT_BUILD_APP": "ON"
      }
    },
    {
      "name": "linux-core",
      "displayName": "Linux core tests",
      "inherits": "linux",
      "cacheVariables": {
        "SINGLILT_BUILD_APP": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "targets": [
        "SingLilt",
        "SingLiltCoreTests",
        "SingLiltNumberedRecognitionTests",
        "SingLiltLanguageTests",
        "SingLiltMigrationTests",
        "SingLiltAudioDecoderTests"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "targets": [
        "SingLilt",
        "SingLiltCoreTests",
        "SingLiltNumberedRecognitionTests",
        "SingLiltLanguageTests",
        "SingLiltMigrationTests",
        "SingLiltAudioDecoderTests"
      ]
    },
    {
      "name": "core-release",
      "configurePreset": "core",
      "configuration": "Release",
      "targets": [
        "SingLiltCoreTests"
      ]
    },
    {
      "name": "core-debug",
      "configurePreset": "core",
      "configuration": "Debug",
      "targets": [
        "SingLiltCoreTests"
      ]
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux",
      "configuration": "Debug",
      "targets": [
        "SingLilt",
        "SingLiltCoreTests",
        "SingLiltNumberedRecognitionTests",
        "SingLiltLanguageTests",
        "SingLiltMigrationTests",
        "SingLiltLinuxMediaTests",
        "SingLiltAudioDecoderTests"
      ]
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core",
      "configuration": "Debug",
      "targets": [
        "SingLiltCoreTests"
      ]
    },
    {
      "name": "linux-release",
      "configurePreset": "linux",
      "configuration": "Release",
      "targets": [
        "SingLilt",
        "SingLiltCoreTests",
        "SingLiltNumberedRecognitionTests",
        "SingLiltLanguageTests",
        "SingLiltMigrationTests",
        "SingLiltLinuxMediaTests",
        "SingLiltAudioDecoderTests"
      ]
    },
    {
      "name": "linux-core-release",
      "configurePreset": "linux-core",
      "configuration": "Release",
      "targets": [
        "SingLiltCoreTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "linux-core-release",
      "configurePreset": "linux-core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    }
  ]
}
